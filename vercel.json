{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build && pnpm run build:blur",
  "outputDirectory": "dist",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/((?!blur(?:/|$)|api/|\\.well-known/).*)",
      "has": [{ "type": "host", "value": "blur.mansoclub.com.ar" }],
      "destination": "/blur/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/registro",
      "destination": "/api/og"
    },
    {
      "source": "/registro/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/blur/:path*",
      "destination": "/blur/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "*/10 * * * *"
    }
  ]
}
